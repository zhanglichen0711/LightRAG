# ============================================================
# LightRAG 中文改造版：DeepSeek (LLM) + Ollama (Embedding) 模板
# 用法：cp env.deepseek.example .env  然后填入你的 DeepSeek API Key
# 完整配置项见 env.example（上游原版，注释非常详细）
# ============================================================

# ---------- LLM：DeepSeek（OpenAI 兼容接口） ----------
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com/v1
LLM_BINDING_API_KEY=sk-你的DeepSeek-API-Key
LLM_MODEL=deepseek-chat
# 并发控制：图谱构建阶段每个 chunk 都要调 LLM，先用默认 4 观察账单
MAX_ASYNC_LLM=4
# 可选：温度
# OPENAI_LLM_TEMPERATURE=0.7

# ---------- Embedding：本地 Ollama（DeepSeek 不提供 embedding 接口） ----------
# 先执行：ollama pull bge-m3
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_BINDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
# bge-m3 输出 1024 维；必须与模型实际维度一致，改了模型记得同步改这里
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
OLLAMA_EMBEDDING_NUM_CTX=8192

# ---------- 服务 ----------
# WebUI 地址：http://localhost:9621
# 默认存储为内存库，重启即清空；生产环境按 env.example 切 PostgreSQL
# LIGHTRAG_KV_STORAGE=JsonKVStorage
